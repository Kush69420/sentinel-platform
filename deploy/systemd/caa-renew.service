[Unit]
Description=Re-authenticate the campus captive-portal session
# Run after caa's own boot-time start attempt, not racing it.
After=caa.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/usr/local/bin/caa-renew.sh

[Install]
# Boot-activated on its own, so every boot gets a real renewal attempt
# rather than relying solely on the timer's OnBootSec.
WantedBy=multi-user.target
