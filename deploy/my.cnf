# SENTINEL Platform — MySQL tuning for the OMV homelab box.
#
# Sized against surveyed hardware: 4 cores, 7.7 GiB RAM total (shared with jellyfin
# and navidrome), and SPINNING HDDs — no SSD anywhere. Every value below that departs
# from the MySQL default does so because of one of those two facts.
[mysqld]
# ── Memory ──────────────────────────────────────────────────────────────
# 2G of 7.7G, leaving room for the OS page cache, the app container and the existing
# media containers. Against the projected ~400 GB dataset this caches well under 1%,
# so the workload MUST stay index-driven point lookups. Raising this starves jellyfin
# long before it meaningfully helps a dataset this size.
innodb_buffer_pool_size = 2G
innodb_buffer_pool_instances = 2

# ── HDD-specific I/O ────────────────────────────────────────────────────
# Defaults assume flash. These do not.
innodb_flush_neighbors = 1   # default 0 (SSD). On HDD, coalescing neighbouring dirty
                             # pages into one seek is a real win.
innodb_io_capacity = 100     # default 200 (SSD); ~100 IOPS is honest for 5400-7200rpm
innodb_io_capacity_max = 200
innodb_flush_method = O_DIRECT   # don't double-buffer in the OS page cache
innodb_read_io_threads = 4
innodb_write_io_threads = 4

# ── Redo log ────────────────────────────────────────────────────────────
# Generous, because the bulk import phase is write-heavy and a small redo log would
# force constant checkpoint flushing against the slowest part of the system.
innodb_redo_log_capacity = 2G

# ── Connections ─────────────────────────────────────────────────────────
# gunicorn runs 1 worker x 8 threads (see Dockerfile), so the app opens at most 8
# concurrent connections. 32 leaves headroom for backups, migrations and a shell.
# The 151 default just reserves memory for connections that can never exist.
max_connections = 32
skip_name_resolve = ON       # no DNS round-trip per connection; grants are by IP

# ── Charset ─────────────────────────────────────────────────────────────
character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci

# ── Durability ──────────────────────────────────────────────────────────
# Full ACID. This box has no UPS, so an unclean power loss is a realistic event and
# the weaker settings (0/2) would risk losing committed transactions.
innodb_flush_log_at_trx_commit = 1
