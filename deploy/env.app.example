# deploy/app.env — the application's environment. Copy to deploy/app.env, fill in,
# chmod 600, NEVER commit. This is the containerised equivalent of the repo-root
# .env.example; read that file for the full annotation of each key.
#
# DB_HOST, DB_NAME, FLASK_ENV and TRUSTED_PROXY_COUNT are set authoritatively in
# docker-compose.yml and will override anything put here — they describe the topology,
# not a preference.

# ── Core ─────────────────────────────────────────────────────────────────
# Outside FLASK_ENV=development the app REFUSES TO START if either of these is unset.
# Generate SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ⚠️ BACK THIS UP OFF THIS BOX, BEFORE FIRST USE.
# It encrypts gov-ID uploads, 2FA secrets and stored API keys. If it is lost or
# regenerated, every encrypted value becomes permanently unrecoverable — and backup.sh
# does NOT include it, by design.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Database ─────────────────────────────────────────────────────────────
# Outside FLASK_ENV=development (this deployment's docker-compose.yml pins
# FLASK_ENV=production, see above) the app REFUSES TO START if either of these is
# unset — same fail-fast treatment as SECRET_KEY/ENCRYPTION_KEY above, because the
# old default (root user, empty password) is a plausible-looking real local MySQL
# account rather than an obviously-broken placeholder.
DB_USER=sentinel_user1
# Must match SENTINEL_DB_PASSWORD in .env.
DB_PASSWORD=

# ── Uploads / request size ───────────────────────────────────────────────
# Must equal `client_max_body_size` in deploy/nginx.docker.conf (default 20m) — a
# mismatch either leaves nginx rejecting first with a generic HTML error, or leaves
# Flask buffering full request bodies nginx was supposed to stop. See .env.example
# for the full annotation.
MAX_CONTENT_LENGTH_MB=20

# ── Sessions and lockout ─────────────────────────────────────────────────
SESSION_TIMEOUT_MIN=60
INACTIVITY_TIMEOUT_MIN=15
FAILED_LOGIN_LIMIT=5
LOCKOUT_HOURS=2
PASSWORD_RESET_TTL_HOURS=24

# Binaries /api/admin/tools/<id>/cli-test is permitted to execute. Empty (the
# default) denies every command. See .env.example for the full annotation.
CLI_TOOL_ALLOWED_BINARIES=

# ── Credits ──────────────────────────────────────────────────────────────
DEFAULT_FREE_CREDITS=20

# ── Payments ─────────────────────────────────────────────────────────────
PAYMENTS_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp (not wired up; present for future use) ──────────────────────
WA_TOKEN=
PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=

# ── Google sign-in for the admin console ─────────────────────────────────
# All three required to enable it; the redirect URI must be registered in the
# Google Cloud Console exactly as written. See .env.example for full notes.
# Which accounts may sign in is an allow-list in admin_users.google_email,
# not configured here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://sentinel.needlegal.in/api/admin/auth/google/callback
# Break-glass password login (leave 0 in production).
ADMIN_PASSWORD_LOGIN=0
