# deploy/app.env — the application's environment. Copy to deploy/app.env, fill in,
# chmod 600, NEVER commit. This is the containerised equivalent of the repo-root
# .env.example; read that file for the full annotation of each key.
#
# DB_HOST, DB_NAME, FLASK_ENV and TRUSTED_PROXY_COUNT are set authoritatively in
# docker-compose.yml and will override anything put here — they describe the topology,
# not a preference.

# ── Core ─────────────────────────────────────────────────────────────────
# Outside FLASK_ENV=development the app REFUSES TO START if either of these is unset.
# Generate SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ⚠️ BACK THIS UP OFF THIS BOX, BEFORE FIRST USE.
# It encrypts gov-ID uploads, 2FA secrets and stored API keys. If it is lost or
# regenerated, every encrypted value becomes permanently unrecoverable — and backup.sh
# does NOT include it, by design.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Database ─────────────────────────────────────────────────────────────
DB_USER=sentinel_user1
# Must match SENTINEL_DB_PASSWORD in .env.
DB_PASSWORD=

# ── Sessions and lockout ─────────────────────────────────────────────────
SESSION_TIMEOUT_MIN=60
INACTIVITY_TIMEOUT_MIN=15
FAILED_LOGIN_LIMIT=5
LOCKOUT_HOURS=2
PASSWORD_RESET_TTL_HOURS=24

# ── Credits ──────────────────────────────────────────────────────────────
DEFAULT_FREE_CREDITS=20

# ── Payments ─────────────────────────────────────────────────────────────
PAYMENTS_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp (not wired up; present for future use) ──────────────────────
WA_TOKEN=
PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
