# deploy/.env — compose-level configuration. Copy to deploy/.env, fill in, chmod 600.
# NEVER commit the real file. This holds the MySQL root password; the application's
# own secrets live in the separate app.env so they are not injected into the DB
# container (and vice versa).

# ── Bind-mount locations on the NAS ──────────────────────────────────────
# Datadir on `blue` (ext4, sdc1, 1.7 TB free). Deliberately not the btrfs pool:
# copy-on-write fragments InnoDB and RAID1 doubles every write.
SENTINEL_MYSQL_DIR=/srv/dev-disk-by-uuid-4ffa1336-6f12-4ff5-9c34-4838e4d865c3/blue/sentinel/mysql

# Uploads and backups on `reed` (btrfs RAID1, sda+sdb) — irreplaceable data gets the
# mirror; the reconstructible bulk table does not.
SENTINEL_UPLOADS_DIR=/srv/dev-disk-by-uuid-0a43fa3a-88f8-4f20-bb26-d92ef3ecb7d8/reed/sentinel/uploads
SENTINEL_BACKUPS_DIR=/srv/dev-disk-by-uuid-0a43fa3a-88f8-4f20-bb26-d92ef3ecb7d8/reed/sentinel/backups
SENTINEL_BACKUP_KEEP_DAYS=14

# ── MySQL ────────────────────────────────────────────────────────────────
# Generate both with: openssl rand -base64 30
MYSQL_ROOT_PASSWORD=
SENTINEL_DB_USER=sentinel_user1
# Must match DB_PASSWORD in app.env.
SENTINEL_DB_PASSWORD=

# ── Cloudflare named tunnel ──────────────────────────────────────────────
# Token for SENTINEL's own tunnel, from the Cloudflare Zero Trust dashboard:
# Networks -> Tunnels -> (the sentinel tunnel) -> Configure -> the `--token` value
# in the install snippet. Ingress lives in the dashboard, not in a config file:
# set its Public Hostname to sentinel.needlegal.in -> HTTP -> nginx:80.
#
# This is NOT the host-level cloudflared that serves probablysecure.tech from
# /etc/cloudflared/config.yml. The two are deliberately separate; do not reuse
# that tunnel's credentials here.
CLOUDFLARE_TUNNEL_TOKEN=
