# SENTINEL Platform — environment template
# Copy to .env and fill in. Never commit the real .env.

# ── Core ────────────────────────────────────────────────────────────────
FLASK_ENV=production
# Signs the session cookie. A predictable value here means forgeable sessions.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=sentinel_user1
DB_PASSWORD=
DB_NAME=sentinel_db

# ── Encryption ──────────────────────────────────────────────────────────
# Encrypts gov-ID uploads, 2FA secrets and stored API keys.
# ⚠️ BACK THIS UP. If it is lost or regenerated, every encrypted value on the
#    platform becomes permanently unrecoverable. If left unset the app generates
#    a throwaway key at each restart, which silently destroys existing data.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Reverse proxy ───────────────────────────────────────────────────────
# Number of trusted proxy hops in front of the app. Used to decide how much of
# X-Forwarded-For to believe when identifying a client.
#   0 = no proxy (default). The header is ignored entirely and remote_addr is used.
#   1 = exactly one reverse proxy (typical: nginx or Caddy on the same host).
# Setting this higher than the number of proxies you actually run lets a client
# forge its own IP and defeat the login rate limit and lockout counter.
TRUSTED_PROXY_COUNT=0

# ── Sessions and lockout ────────────────────────────────────────────────
SESSION_TIMEOUT_MIN=60
INACTIVITY_TIMEOUT_MIN=15
FAILED_LOGIN_LIMIT=5
LOCKOUT_HOURS=2

# Hours an admin-issued password reset code stays valid.
PASSWORD_RESET_TTL_HOURS=24

# ── Credits ─────────────────────────────────────────────────────────────
# Fallback only — the live values are the `signup_free_credits` and
# `lea_approval_free_credits` rows in app_settings, editable in
# Admin → Plans & Payments.
DEFAULT_FREE_CREDITS=20

# ── Payments ────────────────────────────────────────────────────────────
# `manual`   — orders are filed pending and an admin confirms the transfer.
# `razorpay` — live gateway; requires the three keys below.
# The app falls back to `manual` if the selected provider is not fully configured.
PAYMENTS_PROVIDER=manual

# Razorpay (leave blank until the account is onboarded and KYC has cleared).
# Webhook endpoint to register in the Razorpay dashboard, for `payment.captured`:
#   POST https://<your-host>/api/payments/webhook/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp (not wired up; present for future use) ─────────────────────
WA_TOKEN=
PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
