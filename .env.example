# SENTINEL Platform — environment template
# Copy to .env and fill in. Never commit the real .env.

# ── Core ────────────────────────────────────────────────────────────────
FLASK_ENV=production
# Signs the session cookie. A predictable value here means forgeable sessions.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=sentinel_user1
DB_PASSWORD=
DB_NAME=sentinel_db

# ── Encryption ──────────────────────────────────────────────────────────
# Encrypts gov-ID uploads, 2FA secrets and stored API keys.
# ⚠️ BACK THIS UP. If it is lost or regenerated, every encrypted value on the
#    platform becomes permanently unrecoverable. If left unset the app generates
#    a throwaway key at each restart, which silently destroys existing data.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Reverse proxy ───────────────────────────────────────────────────────
# Number of trusted proxy hops in front of the app. Used to decide how much of
# X-Forwarded-For to believe when identifying a client.
#   0 = no proxy (default). The header is ignored entirely and remote_addr is used.
#   1 = exactly one reverse proxy (typical: nginx or Caddy on the same host).
# Setting this higher than the number of proxies you actually run lets a client
# forge its own IP and defeat the login rate limit and lockout counter.
TRUSTED_PROXY_COUNT=0

# ── Sessions and lockout ────────────────────────────────────────────────
SESSION_TIMEOUT_MIN=60
INACTIVITY_TIMEOUT_MIN=15
FAILED_LOGIN_LIMIT=5
LOCKOUT_HOURS=2

# Hours an admin-issued password reset code stays valid.
PASSWORD_RESET_TTL_HOURS=24

# ── CLI tool execution allow-list ──────────────────────────────────────
# /api/admin/tools/<id>/cli-test runs an admin-configured command template
# (services.external_command) with an admin-supplied query spliced in as a
# discrete argv element. Only binaries listed here may actually run — each
# entry is resolved to an absolute, symlink-free real path before comparison,
# so a relative path, `../`, or a symlink can't slip past. Comma-separated;
# entries may be bare names (resolved via $PATH) or absolute paths.
# Default is empty, which denies every command — nothing runs until this is
# explicitly populated with the binaries your CLI-based tools actually need.
#   CLI_TOOL_ALLOWED_BINARIES=/usr/bin/whois,/usr/bin/dig
CLI_TOOL_ALLOWED_BINARIES=

# ── Credits ─────────────────────────────────────────────────────────────
# Fallback only — the live values are the `signup_free_credits` and
# `lea_approval_free_credits` rows in app_settings, editable in
# Admin → Plans & Payments.
DEFAULT_FREE_CREDITS=20

# ── Payments ────────────────────────────────────────────────────────────
# `manual`   — orders are filed pending and an admin confirms the transfer.
# `razorpay` — live gateway; requires the three keys below.
# The app falls back to `manual` if the selected provider is not fully configured.
PAYMENTS_PROVIDER=manual

# Razorpay (leave blank until the account is onboarded and KYC has cleared).
# Webhook endpoint to register in the Razorpay dashboard, for `payment.captured`:
#   POST https://<your-host>/api/payments/webhook/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp (not wired up; present for future use) ─────────────────────
WA_TOKEN=
PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=

# ── Google sign-in for the admin console ────────────────────────────────
# When all three are set, /admin offers "Sign in with Google" and the admin
# password door is switched OFF unless ADMIN_PASSWORD_LOGIN=1 (below).
# Create these in Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth 2.0 Client ID (type: Web application). The redirect URI below must be
# registered there EXACTLY, character for character, or Google refuses with
# redirect_uri_mismatch. It must be an https:// URL on a stable hostname — a
# rotating quick-tunnel URL cannot work, as it would need re-registering every
# time it changes.
#
# These settings only decide WHETHER Google sign-in is offered. WHICH Google
# accounts may actually sign in is an allow-list in the database
# (admin_users.google_email), managed with tools/bootstrap_admin.py — never a
# self-registration.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-host.example/api/admin/auth/google/callback

# Break-glass only. Leave unset/0 in production: with Google sign-in configured
# this re-enables the username+password admin door, which exists so a locked-out
# Google account or a broken consent screen cannot lock you out of the platform
# entirely. Set to 1, get in, fix Google, set it back.
ADMIN_PASSWORD_LOGIN=0
